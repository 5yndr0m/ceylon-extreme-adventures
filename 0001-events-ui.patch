+import Link from 'next/link';
 import Reveal2 from '../components/Reveal';
+import {getUpcomingMonthlyBanners, urlFor} from '../lib/sanity';
+
+type MonthlyBannerCard = {
+  _id: string
+  month: string
+  monthSlug: string
